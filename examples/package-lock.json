{
    "name": "paqjs-examples",
    "lockfileVersion": 2,
    "requires": true,
    "packages": {
        "": {
            "name": "paqjs-examples",
            "dependencies": {
                "@paqjs/core": "file:.."
            }
        },
        "..": {
            "name": "@paqjs/core",
            "version": "2.0.0",
            "license": "MIT",
            "devDependencies": {
                "@napi-rs/cli": "3.5.0"
            },
            "engines": {
                "node": ">= 20"
            },
            "optionalDependencies": {
                "@paqjs/core-darwin-arm64": "2.0.0",
                "@paqjs/core-darwin-x64": "2.0.0",
                "@paqjs/core-linux-ia32-gnu": "2.0.0",
                "@paqjs/core-linux-x64-gnu": "2.0.0",
                "@paqjs/core-win32-ia32-msvc": "2.0.0",
                "@paqjs/core-win32-x64-msvc": "2.0.0"
            }
        },
        "node_modules/@paqjs/core": {
            "resolved": "..",
            "link": true
        }
    },
    "dependencies": {
        "@paqjs/core": {
            "version": "file:..",
            "requires": {
                "@napi-rs/cli": "3.5.0",
                "@paqjs/core-darwin-arm64": "2.0.0",
                "@paqjs/core-darwin-x64": "2.0.0",
                "@paqjs/core-linux-ia32-gnu": "2.0.0",
                "@paqjs/core-linux-x64-gnu": "2.0.0",
                "@paqjs/core-win32-ia32-msvc": "2.0.0",
                "@paqjs/core-win32-x64-msvc": "2.0.0"
            }
        }
    }
}
